---
import PageLayout from '../../layouts/PageLayout.astro';
import NotaireCalculator from '../../components/calc/NotaireCalculator';
import ContentTable from '../../components/ContentTable.astro';
import AdSlot from '../../components/AdSlot.astro';
import Sources from '../../components/Sources.astro';
import { YEAR, LAST_UPDATED } from '../../data/site-config';
import { route, AMOUNTS } from '../../i18n/routes';
import { amountLabel } from '../../i18n/nav';
import { webApplicationSchema, faqSchema, breadcrumbSchema, organizationSchema, personSchema, websiteSchema } from '../../lib/seo';
import { F, $, pct, n, P, COUNT, exempleRows, tranchesRows, tauxGlobalAncien, tauxGlobalNeuf, getDep, nom } from '../../lib/tables';
import { displayDate } from '../../lib/format';
import { ctCalc, ptzCalc, tfDistribution } from '../../lib/immo-tables';
const ct = ctCalc({ prix: 250000, dep: '75', agenceTTC: 10000, taxeFonciereAnnuelle: 1200, jourSignature: 182 });
const pz = ptzCalc({ zone: 'A', personnes: 2, rfr: 38000, cout: 250000, type: 'neuf_collectif' });
const TD = tfDistribution();
const lang = 'fr';
const title = `Frais de notaire ${YEAR} : calcul par département, ancien, neuf`;
const description = `Frais de notaire ${YEAR} calculés avec le taux de votre département au 1er juin : droits de mutation, émoluments, CSI, débours. Ancien, neuf, primo-accédant.`;
const paris = F(250000, '75'); const indre = F(250000, '36'); const nice = F(250000, '06'); const neuf = F(250000, '75', 'neuf'); const primo = F(250000, '75', 'ancien', 'primo');
const t5 = tauxGlobalAncien(5), t45 = tauxGlobalAncien(4.5), t38 = tauxGlobalAncien(3.8);
const ex200 = F(200000, '33');
const a450 = COUNT.a450.map((d) => nom(d, lang)).join(', ');
const faqs = [
  { q: 'Combien de frais de notaire pour un achat de 250 000 € ?', a: `Dans l’ancien, à Paris comme dans tous les départements qui ont voté le taux de 5 %, comptez environ ${$(paris.total)}, soit ${pct(paris.pourcentage)} du prix : ${$(paris.droits)} de droits de mutation, ${$(paris.emoluments.ttc)} d’émoluments TTC, le forfait de formalités, la contribution de sécurité immobilière et ${$(P.debours_defaut)} de débours estimés. Dans l’Indre, la même maison coûte ${$(indre.total)} de frais.` },
  { q: 'Les frais de notaire sont-ils les mêmes partout en France ?', a: `Non. La rémunération du notaire suit un barème national, mais les droits de mutation dépendent du département. Au 1er juin ${YEAR}, ${COUNT.zones5} zones appliquent un taux départemental de 5 % (${pct(t5, lang, 3)} au total), onze départements sont restés à 4,50 % (${pct(t45, lang, 3)}) et l’Indre applique 3,80 % (${pct(t38, lang, 3)}). Sur 250 000 €, l’écart entre Paris et l’Indre dépasse ${$(paris.total - indre.total)}.` },
  { q: 'Pourquoi les frais sont-ils plus faibles dans le neuf ?', a: `Parce qu’une vente soumise à la TVA immobilière ne supporte pas les droits de mutation de droit commun mais une taxe de publicité foncière réduite de 0,70 %, portée à ${pct(tauxGlobalNeuf(), lang, 3)} avec les frais d’assiette. Sur 250 000 €, les frais tombent à ${$(neuf.total)} contre ${$(paris.total)} dans l’ancien parisien. Le notaire perçoit les mêmes émoluments : seule la part fiscale baisse.` },
  { q: 'Qu’est-ce qu’un primo-accédant pour les droits de mutation ?', a: `C’est un acheteur qui n’a pas été propriétaire de sa résidence principale au cours des deux années précédant l’achat et qui achète pour y habiter. Dans les départements à 5 %, il paie 4,50 % : la hausse votée depuis avril 2025 ne s’applique pas à lui. Sur 250 000 €, l’économie atteint ${$(paris.droits - primo.droits)}. La règle est fixée par l’article 116 de la loi de finances pour 2025.` },
  { q: 'Les frais de notaire peuvent-ils être inclus dans le prêt immobilier ?', a: `Certaines banques financent tout ou partie des frais, mais la plupart demandent qu’un apport personnel les couvre, parce que ces sommes ne correspondent à aucune valeur que la banque pourrait saisir. Comptez donc ${pct(paris.pourcentage, lang, 1)} du prix en apport dans l’ancien à 5 %, et environ ${pct(neuf.pourcentage, lang, 1)} dans le neuf, avant même les frais de garantie du prêt.` },
  { q: 'Quand paie-t-on les frais de notaire ?', a: `Le jour de la signature de l’acte authentique, par virement reçu sur le compte du notaire avant le rendez-vous. Le notaire demande une provision un peu supérieure aux frais estimés ; il établit ensuite un décompte définitif et rembourse le trop-perçu, en général après la publication de la vente au service de la publicité foncière, plusieurs semaines plus tard.` },
  { q: 'Le calcul tient-il compte des meubles vendus avec le logement ?', a: `Oui, dans les options avancées. Les meubles listés et estimés de façon réaliste dans l’acte ne supportent pas les droits de mutation immobiliers ni les émoluments proportionnels. Sur un achat de 300 000 € à 5 % avec 10 000 € de mobilier, l’économie dépasse 700 €. Une valeur gonflée expose en revanche à un redressement fiscal.` },
  { q: 'Mes données sont-elles envoyées quelque part ?', a: 'Non. Le calcul est exécuté par votre navigateur avec les barèmes embarqués dans la page : le prix, le département et votre situation ne sont transmis à aucun serveur, ne sont pas enregistrés et ne nécessitent aucun compte. Le lien partageable encode vos saisies dans l’adresse de la page, uniquement si vous choisissez de le copier.' },
];
const related = [
  { href: route('couttotal', lang), name: 'Coût total d’un achat', description: 'Notaire, agence, taxe foncière : le budget complet.' },
  { href: route('ptz', lang), name: 'PTZ 2026', description: 'Le prêt à taux zéro selon la zone de la commune.' },
  { href: route('departements', lang), name: 'Frais par département', description: 'Les 101 départements, taux au 1er juin 2026.' },
  { href: route('comparer', lang), name: 'Comparer deux départements', description: 'Le même bien, deux taux, l’écart en euros.' },
  { href: route('neuf', lang), name: 'Frais de notaire dans le neuf', description: 'Taux réduit, VEFA et terrain de promoteur.' },
  { href: route('primo', lang), name: 'Primo-accédant', description: 'Pourquoi la hausse à 5 % ne vous concerne pas.' },
  { href: route('emoluments', lang), name: 'Émoluments du notaire', description: 'Le barème réglementé, tranche par tranche.' },
  { href: route('tableau', lang), name: 'Tableau des frais par prix', description: 'De 50 000 € à 1 million, ancien et neuf.' },
];
const jsonLd = [webApplicationSchema({ name: `Calcul des frais de notaire ${YEAR}`, description, path: route('home', lang), lang }), faqSchema(faqs, lang), breadcrumbSchema([{ name: 'Accueil', path: route('home', lang) }]), organizationSchema(lang), personSchema(lang), websiteSchema(lang)];
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Calcul des frais de notaire {YEAR} : le taux de votre département, pas une moyenne</h1>
    <p class="mt-3 text-lg text-navy-600">Prix, département, ancien ou neuf : le calculateur applique le taux des droits de mutation voté par <strong>votre</strong> département au 1er juin {YEAR}, le barème réglementé des émoluments (y compris outre-mer) et la règle du primo-accédant.</p>
    <p class="mt-3"><span class="inline-flex items-center gap-1.5 rounded-full border border-navy-200 bg-white px-3 py-1 text-xs font-medium text-navy-600">Tableau DGFiP au 1er juin {YEAR} · tarif des notaires · mis à jour le {displayDate(LAST_UPDATED, 'fr-FR')}</span></p>
  </header>
  <NotaireCalculator client:load lang={lang} methodHref={route('method', lang)} />
  <section class="prose prose-slate max-w-none">
    <p>Pour un logement ancien de 250 000 € à Paris, les frais de notaire s’élèvent à {$(paris.total)}, soit {pct(paris.pourcentage)} du prix. Près de huit euros sur dix ne vont pas au notaire : {$(paris.droits)} sont des droits de mutation reversés au département, à la commune et à l’État. La rémunération réglementée du notaire, elle, représente {$(paris.emoluments.ttc)} TTC d’émoluments proportionnels et {$(paris.formalitesTTC)} de formalités ; s’y ajoutent {$(paris.csi)} de contribution de sécurité immobilière et les débours. Le même achat coûte {$(nice.total)} dans les Alpes-Maritimes, restées à 4,50 %, et {$(indre.total)} dans l’Indre, seul département à 3,80 %. Dans le neuf, la taxe tombe à {pct(tauxGlobalNeuf(), lang, 3)} et les frais à {$(neuf.total)}. Un primo-accédant qui achète sa résidence principale dans un département à 5 % paie {$(primo.total)}. Ces chiffres sont calculés à partir du tableau publié par la DGFiP et du tarif des notaires en vigueur jusqu’en 2028.</p>
    <AdSlot slot="home-1" />
    <h2 id="calcul">Comment les frais de notaire sont calculés</h2>
    <p>Le terme est trompeur : on parle de « frais de notaire », mais il s’agit de frais d’acquisition, dont le notaire n’est que le collecteur pour l’essentiel. Le décompte qu’il vous remet à la signature additionne cinq postes, que le calculateur reproduit un par un.</p>
    <ol>
      <li><strong>Les droits de mutation à titre onéreux.</strong> Taxe départementale (5 %, 4,50 % ou 3,80 % selon le département), taxe communale additionnelle de {pct(P.dmto.taxe_communale)} et prélèvement de l’État pour frais d’assiette, égal à {pct(P.dmto.frais_assiette_droit_commun)} de la taxe départementale. Total : {pct(t5, lang, 3)}, {pct(t45, lang, 3)} ou {pct(t38, lang, 3)} du prix.</li>
      <li><strong>Les émoluments proportionnels.</strong> La rémunération de l’acte de vente, fixée par l’article A444-91 du code de commerce, calculée par tranches dégressives de {pct(P.emoluments.zones.metro.taux[0], lang, 3)} à {pct(P.emoluments.zones.metro.taux[3], lang, 3)}, puis soumise à la TVA de {pct(P.emoluments.zones.metro.tva, lang, 0)}.</li>
      <li><strong>Les émoluments de formalités.</strong> Un forfait de {$(P.emoluments.formalites_forfait_ht, lang, 2)} HT couvre une partie des démarches liées à la publicité foncière.</li>
      <li><strong>La contribution de sécurité immobilière.</strong> {pct(P.csi.taux)} du prix, au minimum {$(P.csi.minimum)}, perçue par l’État pour la publication de la vente.</li>
      <li><strong>Les débours.</strong> Les sommes que le notaire avance pour vous : documents d’urbanisme, état hypothécaire, pièces du syndic, cadastre. Leur montant varie d’un dossier à l’autre ; le calculateur retient {$(P.debours_defaut)} par défaut, à remplacer par le chiffre du devis.</li>
    </ol>
    <h3>Exemple détaillé : 200 000 € en Gironde</h3>
    <p>La Gironde a voté le taux de 5 %. Les droits se décomposent en {$(ex200.droitsDepartement)} de taxe départementale, {$(ex200.droitsCommune)} de taxe communale et {$(ex200.droitsAssiette)} de frais d’assiette, soit {$(ex200.droits)}. Les émoluments se calculent tranche par tranche : {pct(P.emoluments.zones.metro.taux[0], lang, 3)} sur les 6 500 premiers euros, {pct(P.emoluments.zones.metro.taux[1], lang, 3)} jusqu’à 17 000 €, {pct(P.emoluments.zones.metro.taux[2], lang, 3)} jusqu’à 60 000 € et {pct(P.emoluments.zones.metro.taux[3], lang, 3)} au-delà, soit {$(ex200.emoluments.ht, lang, 2)} HT, le chiffre exact de l’exemple publié par service-public.fr. Avec la TVA, cela donne {$(ex200.emoluments.ttc, lang, 2)}. Formalités, CSI et débours portent le total à {$(ex200.total)}.</p>
    <h2 id="departement">Pourquoi votre département change tout</h2>
    <p>La loi de finances pour 2025 a autorisé les départements à relever leur taux de 4,50 % à 5 % pour les ventes signées entre le 1er avril 2025 et le 31 mars 2028. Presque tous l’ont fait : au 1er juin {YEAR}, le tableau de la DGFiP compte {COUNT.zones5} zones à 5 %. Onze départements sont restés à 4,50 % : {a450}. L’Indre est le seul à appliquer encore 3,80 %. Un calculateur qui applique « environ 8 % » partout se trompe donc de plusieurs centaines à plusieurs milliers d’euros selon le lieu.</p>
    <p>Trois départements ont en outre voté des règles particulières, que la plupart des simulateurs ignorent : la Savoie applique 4,00 % aux acheteurs d’une première propriété qui s’engagent à l’occuper cinq ans ; le Calvados a voté un abattement de 46 000 € sur certaines acquisitions ; les Hautes-Pyrénées réduisent le taux à 3,80 % pour les ventes par lots avec droit de préemption du locataire. Le Rhône est coupé en deux : la métropole de Lyon et le reste du département votent séparément, et appliquent tous deux 5 % aujourd’hui.</p>
    <p>Enfin, l’outre-mer a son propre barème d’émoluments, plus élevé, et sa propre TVA : 8,5 % en Guadeloupe, en Martinique et à La Réunion, aucune en Guyane et à Mayotte. Sur un achat de 250 000 € à La Réunion, les émoluments atteignent {$(F(250000, '974').emoluments.ttc)} contre {$(paris.emoluments.ttc)} en métropole. Le <a href={route('departements', lang)}>tableau des 101 départements</a> donne le taux et les frais de chacun ; le <a href={route('comparer', lang)}>comparateur</a> chiffre l’écart entre deux lieux pour le même bien.</p>
    <h2 id="taux">Taux des droits de mutation au 1er juin {YEAR}</h2>
    <ContentTable headers={['Taux départemental', 'Taux global', 'Départements', 'Frais sur 250 000 €']} align={['r', 'r', 'l', 'r']} rows={[
      [pct(5), pct(t5, lang, 3), `${COUNT.zones5} zones (dont Paris, Gironde, Nord, Rhône)`, $(paris.total)],
      [pct(4.5), pct(t45, lang, 3), `${COUNT.a450.length} départements`, $(nice.total)],
      [pct(3.8), pct(t38, lang, 3), 'Indre', $(indre.total)],
      [`${pct(0.7)} (neuf)`, pct(tauxGlobalNeuf(), lang, 3), 'Partout, ventes soumises à la TVA', $(neuf.total)],
    ]} caption="Taux global = taxe départementale + taxe communale de 1,20 % + frais d’assiette. Débours estimés à 500 €." />
    <h2 id="exemples">Exemples de frais de notaire {YEAR} dans l’ancien (département à 5 %)</h2>
    <ContentTable headers={['Prix', 'Droits de mutation', 'Émoluments et formalités TTC', 'CSI et débours', 'Total', 'Part du prix']} align={['r', 'r', 'r', 'r', 'r', 'r']} rows={exempleRows(lang, '75')} />
    <p>La part des frais baisse légèrement quand le prix monte, parce que les émoluments sont dégressifs et que le forfait de formalités et les débours pèsent moins sur un gros montant. Elle ne descend pourtant jamais sous {pct(t5, lang, 2)}, le taux des droits de mutation, qui reste proportionnel quel que soit le prix. Pour un garage ou un petit terrain, l’effet inverse joue : le minimum de {$(P.emoluments.minimum_ht)} HT d’émoluments, le forfait et les débours peuvent porter les frais bien au-delà de 10 % du prix.</p>
    <h2 id="emoluments">Le barème des émoluments du notaire</h2>
    <ContentTable headers={['Tranche du prix', 'Taux HT (métropole)']} align={['l', 'r']} rows={tranchesRows(lang)} caption="Code de commerce, art. A444-91 ; taux applicables depuis le 1er janvier 2021, tarifs valables jusqu’au 29 février 2028." />
    <p>Ce barème est le même chez tous les notaires : on ne choisit pas un notaire moins cher pour un acte de vente. La seule marge de discussion est la remise que le notaire peut consentir, au plus 20 %, sur la part des émoluments calculée au-delà de 100 000 €. Elle doit être affichée à l’étude et accordée à tous les clients dans les mêmes conditions. Voir le guide sur la <a href={route('remise', lang)}>remise sur les émoluments</a>.</p>
    <h2 id="cas">Cas particuliers</h2>
    <h3>Neuf, VEFA et terrain à bâtir vendu par un professionnel</h3>
    <p>Le taux réduit de {pct(tauxGlobalNeuf(), lang, 3)} s’applique aux ventes soumises à la TVA immobilière : logement neuf acheté à un promoteur, vente en l’état futur d’achèvement, revente par un professionnel dans les cinq ans de l’achèvement, terrain à bâtir vendu par un assujetti. Entre particuliers, un terrain ou une maison récente relève du taux de droit commun. Détails dans les guides <a href={route('neuf', lang)}>frais de notaire dans le neuf</a>, <a href={route('vefa', lang)}>VEFA</a> et <a href={route('terrain', lang)}>achat d’un terrain</a>.</p>
    <h3>Primo-accédant et première propriété</h3>
    <p>Le primo-accédant qui achète sa résidence principale échappe à la hausse de 5 %. Dans une zone à 5 %, cela ramène le taux global à {pct(t45, lang, 3)}. En Savoie, la réduction « première propriété » de l’article 1594 F septies du code général des impôts abaisse le taux départemental à 4,00 %, à condition d’occuper le logement à titre de résidence principale pendant cinq ans. Le guide <a href={route('primo', lang)}>primo-accédant</a> détaille les conditions.</p>
    <h3>Donation, garage, plus-value</h3>
    <p>Une donation obéit à d’autres règles : droits de donation après abattement, émoluments propres. Le <a href={route('donation', lang)}>calculateur de donation</a> les applique. Pour un <a href={route('garage', lang)}>garage ou une place de parking</a>, le minimum de perception change la donne. Et à la revente, les frais payés à l’achat majorent le prix d’acquisition retenu pour la plus-value, au réel ou par un forfait de {pct(P.plus_value.forfait_frais_acquisition, lang, 1)} : voir <a href={route('plusvalue', lang)}>frais de notaire et plus-value</a>.</p>
    <AdSlot slot="home-2" />
    <h2 id="tous-les-frais">Les autres frais et taxes de votre achat immobilier</h2>
    <p>Les frais de notaire sont le premier poste, pas le seul. Ce site, Frais Immobilier, calcule avec le même soin chaque frais et chaque taxe d’un achat, hors crédit. Le <a href={route('couttotal', lang)}>coût total d’un achat</a> additionne le prix, les frais de notaire, la commission d’agence et la taxe foncière remboursée au vendeur : pour {$(250000)} à Paris avec {$(10000)} d’agence et une signature début juillet, il atteint {$(ct.total)}. Les <a href={route('agence', lang)}>frais d’agence immobilière</a> se décomposent en honoraires hors taxes et TVA, et leur présentation change l’assiette des droits.</p>
    <p>Pour financer l’achat, le <a href={route('ptz', lang)}>simulateur PTZ {YEAR}</a> lit la zone de votre commune et applique le barème du prêt à taux zéro : {$(pz.montant)} pour un couple qui achète un appartement neuf à {$(250000)} à Nantes. Une fois propriétaire, la <a href={route('taxefonciere', lang)}>taxe foncière</a> se calcule avec les taux votés par chacune des communes, de {pct(TD.min)} à {pct(TD.max)}, et la <a href={route('taxeamenagement', lang)}>taxe d’aménagement</a> avec ceux de la commune et du département pour une construction ou une extension. Pour un investissement, le <a href={route('rendement', lang)}>rendement locatif</a> intègre les frais d’achat réels, et la <a href={route('plusvalueimmo', lang)}>plus-value immobilière</a> chiffre l’impôt prélevé à la revente.</p>
    <h2 id="populaires">Calculs fréquents par prix</h2>
    <ul>{AMOUNTS.map((a) => <li><a href={route(`amount-${a}`, lang)}>Frais de notaire pour un {amountLabel(a, lang).toLowerCase()}</a></li>)}</ul>
    <h2 id="conseils">Six façons légales de payer moins</h2>
    <ol>
      <li>Vérifiez si vous êtes primo-accédant : deux ans sans être propriétaire de votre résidence principale suffisent, sans condition de revenus.</li>
      <li>Faites lister les meubles dans l’acte, avec une valeur réaliste et justifiable (cuisine équipée, électroménager, mobilier).</li>
      <li>Négociez pour que la commission d’agence soit à la charge de l’acquéreur et non incluse dans le prix : elle sort alors de l’assiette des droits.</li>
      <li>Au-delà de 100 000 €, demandez au notaire s’il pratique la remise sur ses émoluments, et à quel taux.</li>
      <li>Comparez avec le neuf : à prix égal, l’écart de frais dépasse souvent cinq points.</li>
      <li>Si vous hésitez entre deux départements limitrophes, chiffrez l’écart avec le <a href={route('comparer', lang)}>comparateur</a>.</li>
    </ol>
    <p>Le guide <a href={route('reduire', lang)}>réduire ses frais de notaire</a> chiffre chaque levier et signale ceux qui exposent à un redressement.</p>
    <Sources lang={lang} />
  </section>
</PageLayout>
