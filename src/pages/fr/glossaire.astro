---
import PageLayout from '../../layouts/PageLayout.astro';
import { YEAR } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { webPageSchema, breadcrumbSchema } from '../../lib/seo';
import { pct, $, P, tauxGlobalAncien, tauxGlobalNeuf } from '../../lib/tables';
const lang = 'fr';
const title = `Glossaire des frais immobiliers ${YEAR} : les mots de l’achat`;
const description = `Glossaire des frais immobiliers ${YEAR} : DMTO, émoluments, débours, PTZ, zonage A/B/C, taxe foncière, plus-value, prix FAI. Définitions courtes, chiffres à jour.`;
const path = route('glossary', lang);
const jsonLd = [webPageSchema({ name: title, description, path, lang }), breadcrumbSchema([{ name: 'Accueil', path: route('home', lang) }, { name: 'Glossaire', path }])];
const T: Array<[string, string, string?]> = [
  ['Acte authentique', 'Acte de vente signé devant le notaire, qui opère le transfert de propriété et rend les frais exigibles.'],
  ['Assiette', 'Montant sur lequel un taux est appliqué : le prix stipulé, diminué des meubles listés et de la commission d’agence à la charge de l’acquéreur.', 'mobilier'],
  ['Compromis de vente', 'Avant-contrat qui engage vendeur et acheteur ; aucun frais d’acquisition n’est dû à ce stade, hors dépôt de garantie.'],
  ['Contribution de sécurité immobilière (CSI)', `Taxe de ${pct(P.csi.taux)} du prix, au minimum ${$(P.csi.minimum)}, perçue par l’État pour la publication de la vente.`, 'csi'],
  ['Débours', 'Sommes avancées par le notaire pour votre compte à des tiers et refacturées sans marge.', 'debours'],
  ['Droits de mutation à titre onéreux (DMTO)', `Impôt sur la vente : taxe départementale, taxe communale et frais d’assiette, ${pct(tauxGlobalAncien(5), lang, 3)} du prix dans un département à 5 %.`, 'dmto'],
  ['Émoluments', 'Rémunération réglementée du notaire pour un acte tarifé, identique dans toutes les études.', 'emoluments'],
  ['Frais d’assiette et de recouvrement', `Prélèvement de l’État égal à ${pct(P.dmto.frais_assiette_droit_commun)} de la taxe départementale (${pct(P.dmto.frais_assiette_taux_reduit)} au taux réduit).`],
  ['Honoraires', 'Rémunération libre du notaire pour une prestation non tarifée, fixée par convention.'],
  ['Primo-accédant', 'Acheteur non propriétaire de sa résidence principale depuis deux ans, qui échappe à la hausse des droits à 5 %.', 'primo'],
  ['Provision sur frais', 'Somme versée au notaire avant la signature, ajustée au compte définitif.'],
  ['Publicité foncière', 'Inscription de la vente au fichier immobilier, qui la rend opposable à tous.'],
  ['Remise', `Réduction facultative d’au plus ${pct(P.emoluments.remise_max, lang, 0)} sur la part des émoluments calculée au-delà de ${$(P.emoluments.remise_seuil)}.`, 'remise'],
  ['Taux réduit', `Taxe de publicité foncière des ventes soumises à la TVA : ${pct(tauxGlobalNeuf(), lang, 3)} du prix, frais d’assiette compris.`, 'neuf'],
  ['Abattement pour durée de détention', `Réduction de la plus-value selon les années pleines de détention : exonération d’impôt sur le revenu à 22 ans, de prélèvements sociaux à 30 ans.`, 'plusvalueimmo'],
  ['Base d’imposition (taxe foncière)', `Moitié de la valeur locative cadastrale, revalorisée chaque année (${pct(P.taxe_fonciere.revalorisation_2026_pct, lang, 1)} en ${YEAR}).`, 'taxefonciere'],
  ['Prix FAI', 'Prix « frais d’agence inclus » : le prix affiché comprend la commission de l’agence.', 'agence'],
  ['PTZ', `Prêt à taux zéro aidé par l’État pour la résidence principale d’un primo-accédant, de ${P.ptz.quotite_individuel_neuf[3]} à ${P.ptz.quotite_collectif_ancien[0]} % du coût selon la tranche et le logement.`, 'ptz'],
  ['Rendement net', 'Loyers encaissés diminués des charges non récupérables et de la taxe foncière, rapportés au coût total, frais de notaire compris.', 'rendement'],
  ['Taxe d’aménagement', `Taxe unique due sur une construction de plus de ${P.taxe_amenagement.surface_exoneree_max} m² : surface × ${$(P.taxe_amenagement.valeur_m2)} le m² en ${YEAR} × taux de la commune et du département.`, 'taxeamenagement'],
  ['Zonage A/B/C', 'Classement des communes selon la tension du marché du logement (A bis, A, B1, B2, C), qui fixe notamment les plafonds du PTZ.', 'ptz'],
  ['VEFA', 'Vente en l’état futur d’achèvement : achat sur plan auprès d’un promoteur, soumis à la TVA et au taux réduit.', 'vefa'],
];
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} breadcrumbs={[{ label: 'Glossaire' }]}>
  <div class="prose prose-slate max-w-none">
    <h1>Glossaire des frais et taxes immobiliers</h1>
    <p>Les termes qui figurent sur un décompte de notaire ou dans les guides du site, avec les chiffres en vigueur. Les définitions renvoient au guide qui développe chaque notion.</p>
    <dl>
      {T.map(([t, d, id]) => <><dt><strong>{t}</strong></dt><dd>{d}{id && <> <a href={route(id, lang)}>Lire le guide</a>.</>}</dd></>)}
    </dl>
  </div>
</PageLayout>
